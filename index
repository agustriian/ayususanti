<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poster Ajaib - Editor</title>
    
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Load html2canvas untuk fitur unduh -->
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
    
    <!-- INI DIA: AI Hapus Latar Belakang (Berfungsi sempurna di Vercel/GitHub) -->
    <script src="https://unpkg.com/@imgly/background-removal@1.4.5/dist/browser/umd/index.js"></script>
    
    <!-- Load Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f3f4f6; }
        .font-serif-custom { font-family: 'Playfair Display', serif; }
        
        /* Kontainer Poster - Proporsi 9:16 untuk IG Story/Tiktok */
        #poster-container {
            width: 360px;
            height: 640px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            position: relative;
            background-color: white;
        }

        /* Latar Belakang Gambar/Warna Poster */
        #poster-bg {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 0;
            background-size: cover;
            background-position: center;
            /* Gradasi Default */
            background-image: linear-gradient(to bottom, #B47B25 0%, #E1B863 30%, #FFFFFF 60%, #8B4513 100%);
            transition: all 0.3s ease;
        }

        /* Cahaya Sorotan di tengah */
        .light-beam {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translateX(-50%);
            width: 250px;
            height: 400px;
            background: radial-gradient(ellipse at top, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 70%);
            z-index: 1;
            pointer-events: none;
        }

        /* Kelas untuk fitur Drag & Drop */
        .draggable {
            cursor: grab;
            position: relative;
            z-index: 10;
        }
        
        .draggable:active { cursor: grabbing; }
        
        /* Efek saat teks diklik untuk diedit */
        .editable-text:hover { outline: 1px dashed rgba(255,255,255,0.5); border-radius: 4px; }
        .editable-text:focus { outline: 2px dashed white; border-radius: 4px; background: rgba(0,0,0,0.1); }

        /* Animasi Loading AI */
        .loader {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #f97316;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Efek Bayangan Teks agar terbaca di gambar terang */
        .text-shadow-sm { text-shadow: 0 1px 2px rgba(0,0,0,0.6); }
        .text-shadow-md { text-shadow: 0 2px 4px rgba(0,0,0,0.7); }
        .text-shadow-lg { text-shadow: 0 4px 6px rgba(0,0,0,0.8); }
    </style>
</head>
