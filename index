    <!-- SCRIPT UTAMA APLIKASI -->
    <script>
        // 1. Fungsi Ganti Gambar Latar Belakang (Dapur dll)
        document.getElementById('bg-upload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const posterBg = document.getElementById('poster-bg');
                    posterBg.style.backgroundImage = `url(${event.target.result})`;
                }
                reader.readAsDataURL(file);
            }
        });

        // 2. FUNGSI INTI: AI Potong Background Gambar Produk
        document.getElementById('product-upload').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const loadingEl = document.getElementById('ai-loading');
            const imgEl = document.getElementById('product-img');
            
            // Tampilkan animasi loading
            loadingEl.classList.remove('hidden');
            
            try {
                // Pastikan fungsi AI sudah ter-load dari unpkg
                if (typeof imglyRemoveBackground === 'undefined') {
                    throw new Error("Sistem AI belum siap. Pastikan Anda terkoneksi ke internet.");
                }

                // Pengaturan letak file otak AI (Wajib agar stabil)
                const config = {
                    publicPath: 'https://unpkg.com/@imgly/background-removal@1.4.5/dist/'
                };
                
                // --- PROSES POTONG GAMBAR OLEH AI ---
                console.log("AI mulai bekerja menghapus background...");
                const imageBlob = await imglyRemoveBackground(file, config);
                
                // Ubah hasil potongan jadi URL yang bisa ditampilkan
                const url = URL.createObjectURL(imageBlob);
                imgEl.src = url;
                
                // Beri efek kosmetik ala studio profesional!
                imgEl.classList.add('drop-shadow-[0_25px_25px_rgba(0,0,0,0.6)]'); // Bayangan 3D
                imgEl.style.filter = 'contrast(1.1) brightness(1.05)'; // Penyesuaian warna
                
                console.log("Gambar berhasil dipotong dan diterapkan!");
                
            } catch (error) {
                // Jika terjadi error (misalnya koneksi putus / model gagal dimuat)
                console.error("Proses AI Gagal:", error);
                alert("Gagal memotong gambar secara otomatis. Menampilkan gambar asli Anda. Error: " + error.message);
                
                // FALLBACK: Tampilkan gambar asli yang diupload user
                const reader = new FileReader();
                reader.onload = (ev) => { 
                    imgEl.src = ev.target.result;
                    imgEl.classList.add('drop-shadow-lg'); // Tetap beri bayangan ringan
                };
                reader.readAsDataURL(file);
            } finally {
                // Matikan animasi loading apapun hasilnya
                loadingEl.classList.add('hidden');
            }
        });

        // 3. Fungsi Ganti Logo
        document.getElementById('logo-upload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    document.getElementById('logo-img').src = event.target.result;
                }
                reader.readAsDataURL(file);
            }
        });

        // 4. Sinkronisasi Form Teks dengan Poster
        const fields = ['title', 'subtitle', 'desc', 'price', 'info', 'logotext', 'ig', 'tiktok'];
        fields.forEach(field => {
            const input = document.getElementById(`input-${field}`);
            const display = document.getElementById(`display-${field}`);
            
            // Ketik di kiri, muncul di kanan
            input.addEventListener('input', (e) => {
                display.innerHTML = e.target.value.replace(/\n/g, '<br>');
            });
            
            // Ketik di kanan (poster), muncul di kiri
            display.addEventListener('input', (e) => {
                let text = e.target.innerHTML.replace(/<br\s*[\/]?>/gi, '\n');
                input.value = text.replace(/<[^>]+>/g, '');
            });
        });

        // 5. Ubah Warna Gradasi
        const colorInputs = ['color1', 'color2', 'color3', 'color4'];
        colorInputs.forEach(id => {
            document.getElementById(id).addEventListener('input', () => {
                const c1 = document.getElementById('color1').value;
                const c2 = document.getElementById('color2').value;
                const c3 = document.getElementById('color3').value;
                const c4 = document.getElementById('color4').value;
                
                // Timpa background gambar menjadi gradasi baru
                document.getElementById('poster-bg').style.backgroundImage = `linear-gradient(to bottom, ${c1} 0%, ${c2} 30%, ${c3} 60%, ${c4} 100%)`;
                document.getElementById('bg-upload').value = ''; // Kosongkan file gambar
            });
        });

        // 6. FUNGSI DRAG AND DROP (Geser Elemen di Poster)
        document.querySelectorAll('.draggable').forEach(elem => {
            let isDragging = false, startX, startY, initialX, initialY, xOffset = 0, yOffset = 0;

            const dragStart = (e) => {
                // Cegah geser jika pengguna sedang ingin mengetik di teks
                if (e.target.classList.contains('editable-text')) return; 
                
                isDragging = true;
                if (e.type === "touchstart") {
                    startX = e.touches[0].clientX - xOffset;
                    startY = e.touches[0].clientY - yOffset;
                } else {
                    startX = e.clientX - xOffset;
                    startY = e.clientY - yOffset;
                }
            };

            const drag = (e) => {
                if (isDragging) {
                    e.preventDefault();
                    if (e.type === "touchmove") {
                        initialX = e.touches[0].clientX - startX;
                        initialY = e.touches[0].clientY - startY;
                    } else {
                        initialX = e.clientX - startX;
                        initialY = e.clientY - startY;
                    }
                    xOffset = initialX; yOffset = initialY;
                    elem.style.transform = `translate3d(${initialX}px, ${initialY}px, 0)`;
                }
            };

            const dragEnd = () => { initialX = xOffset; initialY = yOffset; isDragging = false; };

            // Event Listener untuk Mouse
            elem.addEventListener('mousedown', dragStart);
            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', dragEnd);
            
            // Event Listener untuk Touch Screen (HP)
            elem.addEventListener('touchstart', dragStart, {passive: false});
            document.addEventListener('touchmove', drag, {passive: false});
            document.addEventListener('touchend', dragEnd);
        });

        // 7. FUNGSI UNDUH (Screenshot Kanvas) - SUDAH DIPERBAIKI UNTUK VERCEL
        function downloadPoster() {
            const container = document.getElementById('poster-container');
            const btn = document.querySelector('button');
            const originalText = btn.innerHTML;
            
            // Ubah tombol jadi loading
            btn.innerHTML = "Memproses Screenshot...";
            btn.disabled = true;
            
            // Sembunyikan garis putus-putus saat diedit agar tidak ikut kefoto
            document.querySelectorAll('.editable-text').forEach(el => el.style.outline = 'none');

            // Proses Screenshot Resolusi Tinggi (Scale 3)
            html2canvas(container, { 
                scale: 3, 
                useCORS: true, 
                allowTaint: true, // WAJIB ADA: Mencegah gambar di-block oleh browser saat didownload
                backgroundColor: null 
            })
            .then(canvas => {
                // Konversi canvas menjadi objek Blob yang merupakan file gambar sah
                canvas.toBlob(function(blob) {
                    if (blob) {
                        // Buat URL sementara untuk Blob gambar
                        const url = URL.createObjectURL(blob);
                        
                        // Buat elemen link tersembunyi
                        const link = document.createElement('a');
                        link.href = url;
                        // Paksa ekstensi .png pada nama file
                        link.download = 'Poster_Djoeragan_Pagi.png';
                        
                        // Eksekusi klik untuk memicu download
                        document.body.appendChild(link);
                        link.click();
                        
                        // Bersihkan URL sementara dari memori
                        setTimeout(() => {
                            document.body.removeChild(link);
                            URL.revokeObjectURL(url);
                        }, 100);
                    } else {
                        alert("Gagal memproses gambar. Coba gunakan gambar latar yang ukurannya lebih kecil.");
                    }
                }, 'image/png'); // Pastikan tipe file yang dihasilkan adalah PNG
            })
            .catch(err => {
                alert("Gagal mengunduh gambar. Pastikan background aman.");
                console.error("html2canvas error:", err);
            })
            .finally(() => {
                // Kembalikan tombol seperti semula
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    </script>
</body>
</html>
